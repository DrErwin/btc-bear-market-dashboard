# This repository deliberately contains only the standalone web dashboard.
# Keep local research, prototypes, services, test evidence, and tooling out of Git.
/*

# Files required to run and build the dashboard.
!.gitignore
!README.md
!/dashboard/
!/dashboard/**

# Generated or machine-local dashboard files.
/dashboard/node_modules/
/dashboard/dist/
/dashboard/.vite/
/dashboard/npm-debug.log*
/dashboard/yarn-debug.log*
/dashboard/yarn-error.log*
